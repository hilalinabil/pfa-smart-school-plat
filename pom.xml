<?xml version="1.0" encoding="UTF-8"?>
<!--
  Aggregator only: builds every Java module with one command (./mvnw -B verify).
  No dependencies, no plugins, no shared code. Each module is an independent
  Spring Boot application with its own parent, BOM and Maven Wrapper.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.pfaPrjt</groupId>
    <artifactId>university-platform</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>university-platform</name>

    <modules>
        <module>platform/config-server</module>
        <module>platform/discovery-server</module>
        <module>platform/api-gateway</module>
        <module>services/sample-service</module>
    </modules>
</project>
